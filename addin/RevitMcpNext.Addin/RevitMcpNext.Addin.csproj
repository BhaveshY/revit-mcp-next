<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitYear Condition="'$(RevitYear)' == ''">2024</RevitYear>
    <TargetFramework Condition="'$(RevitYear)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net48</TargetFramework>
    <!-- WPF imaging (capture crop/downscale/JPEG) and UI Automation (dialogs) on net10. -->
    <UseWPF Condition="'$(RevitYear)' == '2027'">true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>RevitMcpNext.Addin</AssemblyName>
    <RootNamespace>RevitMcpNext.Addin</RootNamespace>
    <RevitApiPath Condition="'$(RevitApiPath)' == ''">$(ProgramFiles)\Autodesk\Revit $(RevitYear)</RevitApiPath>
    <DefineConstants>$(DefineConstants);REVIT$(RevitYear)</DefineConstants>
    <DefineConstants Condition="'$(RevitYear)' &gt;= '2024'">$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitYear)' &gt;= '2026'">$(DefineConstants);REVIT2026_OR_GREATER</DefineConstants>
    <!-- Product version; build-addin.ps1 passes -p:SourceRevisionId=<short git sha>. -->
    <McpVersion>0.4.0</McpVersion>
    <!-- Generated by `npm run gen:catalog` (contracts). Embedded when present; the add-in reports CATALOG_MISSING otherwise. -->
    <McpCatalogPath>$(MSBuildThisFileDirectory)..\..\artifacts\catalog\catalog.json</McpCatalogPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <!-- net48: WPF imaging and UI Automation come from the framework (net10 gets them through UseWPF). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitMcpNext.Contracts\RevitMcpNext.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(McpCatalogPath)" Condition="Exists('$(McpCatalogPath)')" LogicalName="RevitMcpNext.catalog.json" Link="Embedded\catalog.json" />
    <EmbeddedResource Include="Common\Aliases\*.json" LogicalName="RevitMcpNext.Aliases.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ValidateRevitConfiguration" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(RevitYear)' != '2024' and '$(RevitYear)' != '2027'"
      Text="Revit $(RevitYear) is not configured. Supported RevitYear values are 2024 and 2027." />
    <Error
      Condition="'$(RevitYear)' == '2024' and '$(TargetFramework)' != 'net48'"
      Text="Revit 2024 must target net48." />
    <Error
      Condition="'$(RevitYear)' == '2027' and '$(TargetFramework)' != 'net10.0-windows'"
      Text="Revit 2027 must target net10.0-windows." />
    <Warning
      Condition="!Exists('$(McpCatalogPath)')"
      Text="artifacts\catalog\catalog.json was not found, so the tool catalog is not embedded. The add-in will report CATALOG_MISSING and refuse catalog keys. Run 'npm run gen:catalog' (or scripts/build-addin.ps1 with node on PATH) and rebuild." />
  </Target>

  <!-- AssemblyInformationalVersion = <McpVersion>+<short git sha>; computed inside the target so a SourceRevisionId
       set by SourceLink during the build is honoured too (full SHAs are shortened to 7 characters). -->
  <Target Name="McpWriteVersionInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <McpRevision>$(SourceRevisionId)</McpRevision>
      <McpRevision Condition="'$(McpRevision)' != '' and $(McpRevision.Length) &gt; 7">$(McpRevision.Substring(0, 7))</McpRevision>
      <McpInformationalVersion>$(McpVersion)</McpInformationalVersion>
      <McpInformationalVersion Condition="'$(McpRevision)' != ''">$(McpVersion)+$(McpRevision)</McpInformationalVersion>
      <McpVersionFile>$(IntermediateOutputPath)RevitMcpNext.Version.g.cs</McpVersionFile>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(McpVersionFile)"
      Lines="[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(McpInformationalVersion)&quot;)]"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(McpVersionFile)" />
      <FileWrites Include="$(McpVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
