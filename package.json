{
  "name": "revit-mcp-next-monorepo",
  "private": true,
  "version": "0.4.0",
  "description": "Clean-room, token-efficient Revit MCP bridge for Claude Code and Codex.",
  "homepage": "https://github.com/BhaveshY/revit-mcp-next#readme",
  "bugs": {
    "url": "https://github.com/BhaveshY/revit-mcp-next/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BhaveshY/revit-mcp-next.git"
  },
  "workspaces": [
    "contracts",
    "broker"
  ],
  "scripts": {
    "build": "npm run build -w contracts && npm run build -w broker && npm run gen:catalog",
    "build:bundle": "node broker/build/bundle.mjs",
    "build:addin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-addin.ps1",
    "build:all": "npm run build && npm run build:bundle && npm run build:addin -- -RevitYear 2024 && npm run build:addin -- -RevitYear 2027",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "gen:catalog": "node contracts/dist/catalog/emit.js",
    "e2e": "node e2e/run.mjs",
    "e2e:surface": "node e2e/run.mjs --profile surface",
    "validate:plugins": "node scripts/validate-plugins.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/install.ps1",
    "uninstall:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/uninstall.ps1",
    "doctor": "node artifacts/broker/revit-mcp-cli.mjs doctor",
    "check:integrations:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-python-integrations.ps1",
    "fixture:revit-project": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-revit-project-from-template.ps1",
    "revit:trust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-revit-addin-trust.ps1",
    "pyrevit:hosts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-pyrevit-hosts-cache.ps1",
    "dynamo:warmup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-dynamo-profile.ps1"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
