<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <RevitYear Condition="'$(RevitYear)' == ''">2024</RevitYear>
    <RevitApiPath Condition="'$(RevitApiPath)' == ''">$(ProgramFiles)\Autodesk\Revit $(RevitYear)</RevitApiPath>
    <DefineConstants>$(DefineConstants);REVIT$(RevitYear)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\addin\RevitMcpNext.Addin\Revit\ParameterWriteContract.cs" Link="ParameterWriteContract.cs" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiPath)\RevitAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRevitConfiguration" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(RevitYear)' != '2021' and '$(RevitYear)' != '2024'"
      Text="The parameter contract supports RevitYear values 2021 and 2024." />
  </Target>
</Project>
